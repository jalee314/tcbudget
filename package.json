{
  "name": "tcbudget",
  "version": "1.0.2",
  "description": "Pokémon TCG P&L Tracker — Track your collection like a stock portfolio",
  "homepage": "https://jalee314.github.io/tcbudget/",
  "author": "jalee314",
  "repository": {
    "type": "git",
    "url": "https://github.com/jalee314/tcbudget.git"
  },
  "bugs": {
    "url": "https://github.com/jalee314/tcbudget/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:local": "npm run build && electron-builder --publish never",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "ag-grid-community": "^32.3.3",
    "ag-grid-react": "^32.3.3",
    "better-sqlite3": "^12.9.0",
    "chart.js": "^4.5.1",
    "justtcg-js": "^0.1.26",
    "react-chartjs-2": "^5.3.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.jalee314.tcbudget",
    "productName": "TCBudget",
    "publish": [
      {
        "provider": "github",
        "owner": "jalee314",
        "repo": "tcbudget",
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
